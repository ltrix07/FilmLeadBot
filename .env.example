# Telegram bot token, obtained from @BotFather
BOT_TOKEN=replace-with-bot-token
# Use host `postgres` with Docker Compose; use `localhost` when running locally.
DATABASE_URL=postgresql+asyncpg://filmtraffic:filmtraffic@postgres:5432/filmtraffic
# A JSON list or a comma-separated list of Telegram user IDs.
ADMIN_IDS=123456789
SUBSCRIPTION_CACHE_TTL_SECONDS=180
# v1 welcome text; it is intentionally configured via environment, not an admin panel.
WELCOME_MESSAGE=Добро пожаловать!
LOG_LEVEL=INFO
